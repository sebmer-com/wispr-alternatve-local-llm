{
  "prompt_config_file": "promptConfig.json",
  "text_replacements_file": "textReplacements.json",
  "command_provider": "openai",
  "control_option_mode": "dump",
  "debug": {
    "enabled": false
  },
  "asr": {
    "model_version": "ultra",
    "language": "system"
  },
  "audio_input": {
    "device_uid": "",
    "device_name": ""
  },
  "hotkeys": {
    "paste": {
      "control": false,
      "option": true,
      "command": true,
      "shift": false
    },
    "dump": {
      "control": true,
      "option": true,
      "command": false,
      "shift": false
    },
    "bluetooth": {
      "enabled": false,
      "keys": []
    }
  },
  "paste": {
    "enabled": true,
    "restore_clipboard": true,
    "paste_delay": 0.1,
    "restore_clipboard_delay": 0.5
  },
  "recordings": {
    "save": false,
    "output_dir": "recordings"
  },
  "dump": {
    "enabled": true,
    "markdown_file": "~/Documents/Obsidian/Daily Notes/YYYY-MM-DD.md",
    "append": true,
    "include_timestamp": true
  },
  "continuous_dump": {
    "enabled": false
  },
  "llm_output": {
    "paste": "clipboard",
    "dump": "dump",
    "bluetooth": "clipboard"
  },
  "bluetooth_keyboard": {
    "port": null,
    "chunk_size": 32
  },
  "audio_ducking": {
    "enabled": true
  },
  "hermes_agent": {
    "executable": "hermes",
    "session_name": "local-audio-voice-agent",
    "workdir": "~",
    "foreground_terminal": true,
    "timeout_seconds": 900
  }
}
