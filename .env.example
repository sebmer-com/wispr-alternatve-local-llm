# Optional: only for explicit command_auth "api_key" mode, billed by API usage.
# Fresh OpenAI/Hermes setup needs no app API key or copied OAuth credentials.
# Keep Hermes logins/tokens in Hermes; a subscription is not a public API key.
# Copy next to the active config.json and fill only the selected provider's key.
# Configure command_provider, command_auth, and command_model in config.json,
# or use fluid-push-to-talk setup. Never put credentials in config.json.
# Keep .env private (0600); it is intentionally ignored by Git.
OPENAI_API_KEY=your-openai-api-key
CEREBRAS_API_KEY=your-cerebras-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
